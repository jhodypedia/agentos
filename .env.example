# ---------------------------------------------------------------------------
# AgentOS configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Application
APP_NAME=AgentOS
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value-at-least-32-characters

# Fernet key used to encrypt provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-valid-fernet-key
# Previous keys, comma-separated, kept for decryption only. Rotate with:
#   1. generate a new key, put the old one here, restart
#   2. uv run agentos rotate-encryption-key
#   3. verify, then remove the old key from this line
ENCRYPTION_KEY_PREVIOUS=

# Docker Compose database credentials (also used to build DATABASE_URL)
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-strong-database-password
POSTGRES_DB=agentos
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Database (asyncpg driver). Inside Docker Compose this is overridden
# automatically to point at the postgres service.
DATABASE_URL=postgresql+asyncpg://agentos:change-me-strong-database-password@localhost:5432/agentos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Web
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_MINUTES=60

# Auth
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=agentos
JWT_AUDIENCE=agentos-api

# Memory (all optional). Leave the embedding pair unset to run lexical-only
# retrieval; set both to a provider slug + embedding model to enable pgvector
# search. The model must produce exactly MEMORY_EMBEDDING_DIMENSIONS values.
MEMORY_EMBEDDING_PROVIDER=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_MAX_CONTEXT_CHARS=8000
MEMORY_MAX_ITEMS=40
MEMORY_RETENTION_DAYS=180
MEMORY_HALF_LIFE_DAYS=30

# Hard ceiling for a single command, plus the resource limits applied to it.
SANDBOX_MAX_TIMEOUT_SECONDS=900
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=256
# Per-workspace disk quota, enforced before writes and before commands run.
WORKSPACE_QUOTA_MB=5120

# Execution sandbox and coding engine
WORKSPACE_ROOT=/data/workspaces
SKILLS_ROOT=/data/skills
SANDBOX_ENABLED=true
# Image used for sandboxed commands. Commands fall back to host execution when
# the image is missing, unless SANDBOX_ALLOW_HOST_EXECUTION=false.
SANDBOX_IMAGE=agentos/sandbox:latest
SANDBOX_ALLOW_HOST_EXECUTION=true
CODING_ENGINE=opencode
CODING_MAX_TURNS=30

# make.fun bounties. Read routes work without a key; entering a competition
# needs one (x-api-key, 30-day lifetime). Without it the board still syncs and
# submissions fail with a clear authentication error rather than silently.
MAKEFUN_API_KEY=
MAKEFUN_BASE_URL=https://make.fun
MAKEFUN_TIMEOUT_SECONDS=30
MAKEFUN_SYNC_LIMIT=25
SECURITY_SANDBOX_IMAGE=agentos/research:latest

# Telegram (optional). Without a token the bot process exits immediately and
# the API keeps working; notifications are simply never sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_NOTIFY_INTERVAL_SECONDS=30

# Worker (Phase 11). Poll interval when the queue is empty, and how long a
# claimed task's lease lasts before another worker may take it over.
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LEASE_SECONDS=300

# Dashboard (frontend/). NEXT_PUBLIC_API_URL is baked into the bundle at build
# time and must be the origin the operator's BROWSER reaches, not the compose
# service name. Leave empty to call the API on the same origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
WEB_PORT=3000

# Reverse proxy (deploy/docker-compose.prod.yml). PUBLIC_HOST is the domain the
# operator reaches, PROXY_PORT the host port for plain HTTP that Caddy upgrades.
PUBLIC_HOST=localhost
PROXY_PORT=80
# Set to 1 to let Caddy obtain a Let's Encrypt certificate automatically. It
# requires PUBLIC_HOST to resolve to this machine and ports 80/443 to be open.
# scripts/deploy.sh then selects deploy/Caddyfile.tls by itself.
TLS_AUTO=0
# Contact address for certificate expiry notices (required when TLS_AUTO=1).
ACME_EMAIL=
# Leave unset to let deploy.sh choose the Caddyfile from TLS_AUTO. Set it to
# point at your own file, e.g. PROXY_CONFIG=Caddyfile.internal.
# PROXY_CONFIG=Caddyfile

# Observability and hardening (Phase 10)
# Prometheus text exposition at /metrics. The endpoint has no JWT, so either
# set a token here or keep the port off the public network.
METRICS_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
SLOW_REQUEST_MS=2000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_HEADERS=true
# Only enable behind a proxy that overwrites X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Retention windows used by `uv run agentos prune` (0 keeps forever).
RETENTION_TASK_EVENTS_DAYS=30
RETENTION_AUDIT_DAYS=180
RETENTION_MODEL_USAGE_DAYS=365

# Bootstrap owner (used by scripts/seed.py; remove after first run)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
